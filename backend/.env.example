# ── RaktaSetu backend config ──────────────────────────────────────────────
# Copy this file to `.env` and fill in YOUR local values.
# The `.env` file is yours alone — never commit it, never share it.

# MySQL (your local server, the one MySQL Workbench connects to)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=raktasetu

# Server
PORT=5000

# Auth — any long random string. Generate one, e.g. with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Twilio SMS (phase 5 — leave blank for now)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Deploy (Railway) ────────────────────────────────────────────────────
# Option A: paste the MySQL plugin's connection string (preferred on Railway)
# DATABASE_URL=mysql://root:xxxx@containers-xxx.railway.app:6xxx/raktasetu
# Option B: individual vars (or local dev)
# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME as above
#
# FRONTEND_URL: your deployed frontend origin(s), comma-separated, so the
# browser is allowed to call the API (CORS). e.g.:
# FRONTEND_URL=https://raktasetu.vercel.app
